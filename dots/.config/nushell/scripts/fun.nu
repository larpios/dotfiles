export def emojify [
    text: string
] {
    const table = {
        '가방' : '🎒',
        '주의' : '⚠️',
        '아래' : '👇',
        '바다' : '🌊',
        '가지' : '🍆',
        '사과' : '🍎',
        '죄송' : '🙇',
        '오른' : '👉',
        '왼' : '👈',
        '섬' : '🏝️',
        '쌀' : '🌾',
        '엿' : '🖕',
        '병' : '🫙',
        '붓' : '🖌️',
        '닻' : '⚓',
        '덫' : '🪤',
        '뼈' : '🦴',
        '혀' : '👅',
        '굴' : '🦪',
        '땀' : '💦',
        '꿀' : '🍯',
        '똥' : '💩',
        '밤' : '🌰',
        '해' : '☀️',
        '성' : '🏰',
        '복' : '🐡',
        '북' : '🥁',
        '연' : '🪁',
        '용' : '🐉',
        '게' : '🦀',
        '문' : '🚪',
        '별' : '🌟',
        '자' : '📐',
        '소' : '🐮',
        '공' : '⚽',
        '군' : '🪖',
        '표' : '📊',
        '새' : '🐦',
        '비' : '🌧️',
        '개' : '🐕',
        '위' : '👆',
        '약' : '💊',
        '달' : '🌙',
        '물' : '💧',
        '불' : '🔥',
        '산' : '🏔️',
        '눈' : '❄️',
        '꽃' : '🌸',
        '말' : '🐴',
        '집' : '🏠',
        '총' : '🔫',
        '칼' : '🗡️',
        '옷' : '👕',
        '손' : '🖐️',
        '귀' : '👂',
        '발' : '🦶',
        '화' : '😡',
        '잠' : '💤',
        '책' : '📚',
        '배' : '🚢',
        '돈' : '💰',
        '양' : '🐏',
        '곰' : '🐻',
        '뱀' : '🐍',
        '닭' : '🐔',
        '벌' : '🐝',
        '쥐' : '🐁',
        '알' : '🥚',
        '빵' : '🍞',
        '차' : '🚗',
        '술' : '🍺',
        '밥' : '🍚',
    }

    $table
    | transpose find replace
    | reduce --fold $text {|it, acc|
        $acc | str replace --all $it.find $it.replace
    }
}

